# Copy to .env (git-ignored). Keep the real values in your password manager.
OPENTODO_PORT=8080                                   # host port on 127.0.0.1
OPENTODO_BASE_URL=https://todo.example.com           # the URL people and the Obsidian plugin use (https → secure cookies, passkeys, push)
OPENTODO_SETUP_TOKEN=                                # openssl rand -hex 16; asked once when the owner account is created
OPENTODO_FUNNEL_PATH=                                # openssl rand -hex 16; secret path of the public MCP entry for claude.ai (Tailscale Funnel setups)
OPENTODO_AGENT_TOKEN=                                # ot_… token with scope «agent» (Settings → Integrations → AI assistants); used by local Claude Code and Hermes
