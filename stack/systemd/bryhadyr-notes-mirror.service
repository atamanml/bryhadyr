[Unit]
Description=Mirror Obsidian project notes into OpenTodo (stack/notes_mirror.py)
After=network-online.target docker.service

[Service]
Type=oneshot
# @REPO@ is replaced by scripts/install-timers.sh with the path of this checkout.
# Optional settings (OBSIDIAN_VAULT, OBSIDIAN_VAULT_NAME, BRYHADYR_NOTES_RULES, BRYHADYR_LANG) go into ~/.config/bryhadyr/env.
EnvironmentFile=-%h/.config/bryhadyr/env
ExecStart=/usr/bin/python3 @REPO@/stack/notes_mirror.py
