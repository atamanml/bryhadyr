{
  "extraKnownMarketplaces": {
    "brygadyr": {
      "source": { "source": "github", "repo": "OWNER/brygadyr" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "brygadyr@brygadyr": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/brygadyr/session-start.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
